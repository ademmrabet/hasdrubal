{
  "name": "hasdrubal",
  "version": "0.1.0",
  "private": true,
  "description": "Systeme de gestion du restaurant Hasdrubal",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "check": "npm test && npm run build",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "setup": "npm install && npm run migrate && npm run seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f server web",
    "import:menu": "npm run import:menu --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
