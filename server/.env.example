# --- Serveur ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Base de donnees ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hasdrubal
# Mettre true si le serveur Postgres exige le SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# --- Securite ---
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changez-moi-access
JWT_REFRESH_SECRET=changez-moi-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Restaurant ---
RESTAURANT_NAME=Hasdrubal de Carthage
DEFAULT_VAT_RATE=19

# Cookie de session "Secure" : true derriere HTTPS (defaut en production),
# false si l'application est servie en HTTP sur le reseau local.
# COOKIE_SECURE=false
