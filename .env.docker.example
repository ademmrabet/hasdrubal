# Copier ce fichier en ".env" a la racine du depot, puis remplir les valeurs.
# Ce .env est ignore par git : il contient les secrets de production.

# Port sur lequel l'application est accessible : http://<machine>:8080
HTTP_PORT=8080

# Adresse a laquelle le personnel ouvre l'application.
PUBLIC_URL=http://localhost:8080

# Base de donnees (le conteneur la cree au premier demarrage)
POSTGRES_DB=hasdrubal
POSTGRES_USER=hasdrubal
# Lettres et chiffres uniquement : le mot de passe est insere dans une URL de connexion.
POSTGRES_PASSWORD=

# Secrets de session : 32 caracteres minimum, differents l'un de l'autre.
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# false tant que l'application est servie en HTTP (reseau local du restaurant).
# true des qu'elle est derriere HTTPS : sans cela, la session peut etre interceptee.
COOKIE_SECURE=false

# --- Production avec docker-compose.prod.yml uniquement ---
# Proprietaire du depot GitHub (en minuscules) : ghcr.io/<proprietaire>/hasdrubal-server
GHCR_OWNER=ademmrabet
# "latest" = mises a jour automatiques. Un tag "sha-<commit>" fige une version.
IMAGE_TAG=latest
# Fichier d'identifiants Docker lu par Watchtower pour les images privees.
DOCKER_CONFIG_FILE=~/.docker/config.json
